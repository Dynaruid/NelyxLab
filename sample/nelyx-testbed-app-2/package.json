    "@nelyx/backend-wasm": "file:.nelyx/supply/nelyx-backend-wasm-0.1.0-9b0ef85464d0251882cb2e4fe067e51404271b9e26998586daecbeb832de8edb.tgz",
    "@nelyx/backend-tauri": "file:.nelyx/supply/nelyx-backend-tauri-0.1.0-cf9f4cfbb3e54d3d8401d5e8666f0fd495276a3e106af838c9da5a974c6e9f6b.tgz",
    "@tauri-apps/api": "2.12.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "@nelyx/vite": "file:.nelyx/supply/nelyx-vite-0.1.0-1ae7bca22dab69faa193cc00acd1cc4db04d313516a928763884d9e27fc676f6.tgz",
    "@nelyx/cli": "file:.nelyx/supply/nelyx-cli-0.11.0-57c2492393928ae601a87e88a8ec239036a6535d325cb8ffff435b6a7a05e7f9.tgz",
    "@nelyx/tooling-contracts": "file:.nelyx/supply/nelyx-tooling-contracts-0.1.0-1f3694744b75fb5587bb9d8e59ddff46c6f4a3603d28aec84c26c7b2d5b4da67.tgz",
    "vite": "8.3.8",
    "typescript": "7.0.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  },
  "type": "module",
  "nelyx": {
    "schema": "nelyx.app/v4",
    "name": "NelyxTestbed2",
    "appEntry": "./src/index.ts",
    "assets": [
      {
        "id": "sample-font",
        "kind": "font",
        "path": "./assets/NotoSansKR.ttf",
        "fontFamily": "NelyxSample",
        "notice": {
          "path": "./assets/NotoSansKR-OFL.txt"
        }
      },
      {
        "id": "nelyx-material-icons",
        "kind": "font",
        "path": "./assets/nelyx/MaterialIcons.otf",
        "fontFamily": "MaterialIcons",
        "notice": {
          "path": "./assets/nelyx/MaterialIcons-LICENSE.txt"
        },
        "packageSource": {
          "package": "@nelyx/material",
          "path": "./assets/MaterialIcons.otf",
          "noticePath": "./licenses/MaterialIcons-LICENSE.txt"
        }
      },
      {
        "id": "nelyx-cupertino-icons",
        "kind": "font",
        "path": "./assets/nelyx/CupertinoIcons.ttf",
        "fontFamily": "packages/cupertino_icons/CupertinoIcons",
        "notice": {
          "path": "./assets/nelyx/CupertinoIcons-LICENSE.txt"
        },
        "packageSource": {
          "package": "@nelyx/cupertino",
          "path": "./assets/CupertinoIcons.ttf",
          "noticePath": "./licenses/CupertinoIcons-LICENSE.txt"
        }
      },
      {
        "id": "component-image",
        "kind": "image",
        "path": "./assets/component-image.webp"
      }
    ],
    "displayName": "Nelyx Testbed 2",
    "backend": {
      "manifest": "./backend/Cargo.toml"
    },
    "targets": {
      "web": {
        "pwa": {
          "id": "/apps/nelyx-testbed",
          "shortName": "Nelyx Testbed",
          "themeColor": "#101827",
          "icons": [
            {
              "src": "./assets/pwa/icon-192.png",
              "sizes": "192x192",
              "type": "image/png"
            },
            {
              "src": "./assets/pwa/icon-512.png",
              "sizes": "512x512",
              "type": "image/png"
            }
          ]
        }
      },
      "tauri": {
        "identifier": "dev.nelyx.nelyxtestbed2.tauri",
        "productName": "Nelyx Testbed 2",
        "windows": [
          {
            "label": "main",
            "title": "Nelyx Testbed 2 · Tauri",
            "useHttpsScheme": true,
            "width": 1200,
            "height": 800
          }
        ]
      }
    }
  }
}
