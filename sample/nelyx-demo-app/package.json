{
  "name": "@nelyx/demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "doctor:web": "nelyx doctor --app . --target web",
    "prepare:web": "nelyx prepare --app . --target web",
    "dev:web": "nelyx dev --app . --target web",
    "build:web": "nelyx build --app . --target web",
    "run:web": "nelyx run --app . --target web",
    "doctor:tauri": "nelyx doctor --app . --target tauri",
    "prepare:tauri": "nelyx prepare --app . --target tauri",
    "dev:tauri": "nelyx dev --app . --target tauri",
    "build:tauri": "nelyx build --app . --target tauri",
    "pack:tauri": "nelyx pack --app . --target tauri",
    "run:tauri": "nelyx run --app . --target tauri",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nelyx/core": "file:.nelyx/supply/nelyx-core-0.17.0-63611016214abbf5a74296430e2eb094b9c55c03cb23b2d25da92460c05444e4.tgz",
    "@nelyx/sdk": "file:.nelyx/supply/nelyx-sdk-0.21.0-3310d12f2467aba6cad641500429bafe913d635c71bd1114823e0af9689f48fb.tgz",
    "@nelyx/material": "file:.nelyx/supply/nelyx-material-0.2.0-4153aa11dea66bcc8ea3fdb4f608bd93d8936f6e5c662061f2805378c48c9e5c.tgz",
    "@nelyx/cupertino": "file:.nelyx/supply/nelyx-cupertino-0.2.0-7ff613dc916bccdfa1a7bacbcca18114eeab69602f1cd65f860885b1645525bd.tgz",
    "@nelyx/skia-web": "file:.nelyx/supply/nelyx-skia-web-0.6.0-0cbe1879dc7bd9d0817471c5a5fd9c1a619cdcc5c035f1f60fdbd0548568afd0.tgz",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@nelyx/backend-rust": "file:.nelyx/supply/nelyx-backend-rust-0.1.0-d00f80ce0d9faf18ee8e5df2302fec505102244930da8849e43c34f842ace07d.tgz",
    "@nelyx/backend-wasm": "file:.nelyx/supply/nelyx-backend-wasm-0.1.0-e1d4f2de2a7dbf51a7014e2cbda32632273525acc25feebd7e5ae67decc7d8a4.tgz",
    "@nelyx/backend-tauri": "file:.nelyx/supply/nelyx-backend-tauri-0.1.0-f8f8e49af66f20b66f20d587f1405cb9ad4837e44d0ce0456d20c6053d60b83e.tgz",
    "@tauri-apps/api": "2.12.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "@nelyx/vite": "file:.nelyx/supply/nelyx-vite-0.1.0-a463d7c30f8fe64fd8dfdc5976d07e226a9fb4181a739d309cf4d6203aff07e2.tgz",
    "@nelyx/cli": "file:.nelyx/supply/nelyx-cli-0.11.0-76b4579ca0343a9d7f32081134bfff9664a2480d8d867f9e7ec89f687be718de.tgz",
    "@nelyx/tooling-contracts": "file:.nelyx/supply/nelyx-tooling-contracts-0.1.0-1f3694744b75fb5587bb9d8e59ddff46c6f4a3603d28aec84c26c7b2d5b4da67.tgz",
    "vite": "8.3.8",
    "typescript": "7.0.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  },
  "type": "module",
  "nelyx": {
    "schema": "nelyx.app/v4",
    "name": "NelyxDemoApp",
    "appEntry": "./src/index.ts",
    "crossOriginIsolated": true,
    "assets": [
      {
        "id": "sample-font",
        "kind": "font",
        "path": "./assets/NotoSansKR.ttf",
        "fontFamily": "NelyxSample",
        "notice": {
          "path": "./assets/NotoSansKR-OFL.txt"
        }
      },
      {
        "id": "sample-emoji",
        "kind": "font",
        "path": "./assets/NotoColorEmoji.ttf",
        "fontFamily": "NelyxEmoji",
        "notice": {
          "path": "./assets/NotoColorEmoji.ttf.LICENSE.txt"
        }
      },
      {
        "id": "sample-rtl-hebrew",
        "kind": "font",
        "path": "./assets/NotoSansHebrew.ttf",
        "fontFamily": "NelyxHebrew",
        "notice": {
          "path": "./assets/NotoSansHebrew-OFL.txt"
        }
      },
      {
        "id": "sample-rtl-arabic",
        "kind": "font",
        "path": "./assets/NotoNaskhArabic-Regular.ttf",
        "fontFamily": "NelyxArabic",
        "notice": {
          "path": "./assets/NotoNaskhArabic-Regular.ttf.LICENSE.txt"
        }
      },
      {
        "id": "nelyx-material-icons",
        "kind": "font",
        "path": "./assets/nelyx/MaterialIcons.otf",
        "fontFamily": "MaterialIcons",
        "notice": {
          "path": "./assets/nelyx/MaterialIcons-LICENSE.txt"
        },
        "packageSource": {
          "package": "@nelyx/material",
          "path": "./assets/MaterialIcons.otf",
          "noticePath": "./licenses/MaterialIcons-LICENSE.txt"
        }
      },
      {
        "id": "nelyx-cupertino-icons",
        "kind": "font",
        "path": "./assets/nelyx/CupertinoIcons.ttf",
        "fontFamily": "packages/cupertino_icons/CupertinoIcons",
        "notice": {
          "path": "./assets/nelyx/CupertinoIcons-LICENSE.txt"
        },
        "packageSource": {
          "package": "@nelyx/cupertino",
          "path": "./assets/CupertinoIcons.ttf",
          "noticePath": "./licenses/CupertinoIcons-LICENSE.txt"
        }
      },
      {
        "id": "component-image",
        "kind": "image",
        "path": "./assets/component-image.webp"
      }
    ],
    "displayName": "Nelyx Demo",
    "backend": {
      "manifest": "./backend/Cargo.toml"
    },
    "targets": {
      "web": {
        "pwa": {
          "id": "/apps/nelyx-demo",
          "shortName": "Nelyx Demo",
          "themeColor": "#101827",
          "icons": [
            {
              "src": "./assets/pwa/icon-192.png",
              "sizes": "192x192",
              "type": "image/png"
            },
            {
              "src": "./assets/pwa/icon-512.png",
              "sizes": "512x512",
              "type": "image/png"
            }
          ]
        }
      },
      "tauri": {
        "identifier": "dev.nelyx.demo.tauri",
        "productName": "Nelyx Demo Tauri",
        "deepLinks": {
          "schemes": [
            "nelyx-demo"
          ]
        },
        "deviceUsage": {
          "location": "Show your current position while you use the device services demo.",
          "camera": "Preview the camera and scan barcodes when you choose a camera action.",
          "nfc": "Read or write a text record when you choose an NFC action.",
          "biometrics": "Verify your identity when you choose the authentication demo."
        },
        "windows": [
          {
            "label": "main",
            "title": "Nelyx Demo · Tauri",
            "useHttpsScheme": true,
            "width": 1200,
            "height": 800,
            "safeArea": true,
            "haptics": true,
            "androidBack": true,
            "systemChrome": true,
            "windowsAcrylic": true,
            "windowsRetainedViewport": true,
            "deviceServices": [
              "location",
              "notifications",
              "files",
              "openUrl",
              "deepLinks",
              "store",
              "camera",
              "barcode",
              "nfc",
              "biometrics",
              "credentials",
              "battery",
              "sensors",
              "bluetooth",
              "share"
            ],
            "clipboard": {
              "read": true,
              "write": true
            }
          }
        ]
      }
    }
  }
}
