{
  "name": "@nelyx/demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "doctor:web": "nelyx doctor --app . --target web",
    "prepare:web": "nelyx prepare --app . --target web",
    "dev:web": "nelyx dev --app . --target web",
    "build:web": "nelyx build --app . --target web",
    "run:web": "nelyx run --app . --target web",
    "doctor:tauri": "nelyx doctor --app . --target tauri",
    "prepare:tauri": "nelyx prepare --app . --target tauri",
    "dev:tauri": "nelyx dev --app . --target tauri",
    "build:tauri": "nelyx build --app . --target tauri",
    "pack:tauri": "nelyx pack --app . --target tauri",
    "run:tauri": "nelyx run --app . --target tauri",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nelyx/core": "file:.nelyx/supply/nelyx-core-0.17.0-a7ad670ff6ac686f7cd5faaf18c8cf7583cc2ac1bb27fcaa9733457afc20cce1.tgz",
    "@nelyx/sdk": "file:.nelyx/supply/nelyx-sdk-0.21.0-2d76b00fe1fb63d3b7ad345194c3be33aac5252397d8d3c62d0d30a5798764a8.tgz",
    "@nelyx/material": "file:.nelyx/supply/nelyx-material-0.2.0-2764c4ecb6445d6e4cd36f783682e94fb60a036704911a4b64509cdbd72c38a7.tgz",
    "@nelyx/cupertino": "file:.nelyx/supply/nelyx-cupertino-0.2.0-eb19c480da6f885ab5bbfadfc7612c4289f0732448aa2f37432c2c885e9857d9.tgz",
    "@nelyx/skia-web": "file:.nelyx/supply/nelyx-skia-web-0.6.0-cb987a9109875d7206d9cdf0195e4ceafe130e9e4c5f74782d8ca8e657d58e55.tgz",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@nelyx/backend-rust": "file:.nelyx/supply/nelyx-backend-rust-0.1.0-179e6ed2b2596ca32be70a163b356c20e518299cec01fe5112e48b1cd6193695.tgz",
    "@nelyx/backend-wasm": "file:.nelyx/supply/nelyx-backend-wasm-0.1.0-9ac49342a9b79726fc0d67ff6b368d9c0f0d276a07ceea605ab36c386e7e5c18.tgz",
    "@nelyx/backend-tauri": "file:.nelyx/supply/nelyx-backend-tauri-0.1.0-7c14334e926158cc84146f6250fd6eb9752c58ceaf7bd33e403ecfb44b9e8107.tgz",
    "@tauri-apps/api": "2.12.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "@nelyx/vite": "file:.nelyx/supply/nelyx-vite-0.1.0-ffaf669cc8851b850ff3e043d7e73d01fced6d10966d45f3f8fc3dc58877d68f.tgz",
    "@nelyx/cli": "file:.nelyx/supply/nelyx-cli-0.11.0-6bce0dee9915d9a6d6fed75d7873a80e2c7a886b879e68063e2dbcf8651416bd.tgz",
    "@nelyx/tooling-contracts": "file:.nelyx/supply/nelyx-tooling-contracts-0.1.0-7835531f1ba9ec3f40a312583718cc3fdb7a85cf152d30b8fff179a2c43c6b37.tgz",
    "vite": "8.3.8",
    "typescript": "7.0.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  },
  "type": "module",
  "nelyx": {
    "schema": "nelyx.app/v4",
    "name": "NelyxDemoApp",
    "appEntry": "./src/index.ts",
    "assets": [
      {
        "id": "sample-font",
        "kind": "font",
        "path": "./assets/NotoSansKR.ttf",
        "fontFamily": "NelyxSample",
        "notice": {
          "path": "./assets/NotoSansKR-OFL.txt"
        }
      },
      {
        "id": "sample-emoji",
        "kind": "font",
        "path": "./assets/NotoColorEmoji.ttf",
        "fontFamily": "NelyxEmoji",
        "notice": {
          "path": "./assets/NotoColorEmoji.ttf.LICENSE.txt"
        }
      },
      {
        "id": "sample-rtl-hebrew",
        "kind": "font",
        "path": "./assets/NotoSansHebrew.ttf",
        "fontFamily": "NelyxHebrew",
        "notice": {
          "path": "./assets/NotoSansHebrew-OFL.txt"
        }
      },
      {
        "id": "sample-rtl-arabic",
        "kind": "font",
        "path": "./assets/NotoNaskhArabic-Regular.ttf",
        "fontFamily": "NelyxArabic",
        "notice": {
          "path": "./assets/NotoNaskhArabic-Regular.ttf.LICENSE.txt"
        }
      },
      {
        "id": "nelyx-material-icons",
        "kind": "font",
        "path": "./assets/nelyx/MaterialIcons.otf",
        "fontFamily": "MaterialIcons",
        "notice": {
          "path": "./assets/nelyx/MaterialIcons-LICENSE.txt"
        },
        "packageSource": {
          "package": "@nelyx/material",
          "path": "./assets/MaterialIcons.otf",
          "noticePath": "./licenses/MaterialIcons-LICENSE.txt"
        }
      },
      {
        "id": "nelyx-cupertino-icons",
        "kind": "font",
        "path": "./assets/nelyx/CupertinoIcons.ttf",
        "fontFamily": "packages/cupertino_icons/CupertinoIcons",
        "notice": {
          "path": "./assets/nelyx/CupertinoIcons-LICENSE.txt"
        },
        "packageSource": {
          "package": "@nelyx/cupertino",
          "path": "./assets/CupertinoIcons.ttf",
          "noticePath": "./licenses/CupertinoIcons-LICENSE.txt"
        }
      },
      {
        "id": "component-image",
        "kind": "image",
        "path": "./assets/component-image.webp"
      }
    ],
    "displayName": "Nelyx Demo",
    "backend": {
      "manifest": "./backend/Cargo.toml"
    },
    "targets": {
      "web": {
        "pwa": {
          "id": "/apps/nelyx-demo",
          "shortName": "Nelyx Demo",
          "themeColor": "#101827",
          "icons": [
            {
              "src": "./assets/pwa/icon-192.png",
              "sizes": "192x192",
              "type": "image/png"
            },
            {
              "src": "./assets/pwa/icon-512.png",
              "sizes": "512x512",
              "type": "image/png"
            }
          ]
        }
      },
      "tauri": {
        "identifier": "dev.nelyx.demo.tauri",
        "productName": "Nelyx Demo Tauri",
        "deepLinks": {
          "schemes": [
            "nelyx-demo"
          ]
        },
        "deviceUsage": {
          "location": "Show your current position while you use the device services demo.",
          "camera": "Preview the camera and scan barcodes when you choose a camera action.",
          "nfc": "Read or write a text record when you choose an NFC action.",
          "biometrics": "Verify your identity when you choose the authentication demo."
        },
        "windows": [
          {
            "label": "main",
            "title": "Nelyx Demo · Tauri",
            "useHttpsScheme": true,
            "width": 1200,
            "height": 800,
            "safeArea": true,
            "haptics": true,
            "androidBack": true,
            "deviceServices": [
              "location",
              "notifications",
              "files",
              "openUrl",
              "deepLinks",
              "store",
              "camera",
              "barcode",
              "nfc",
              "biometrics",
              "credentials",
              "battery",
              "sensors",
              "bluetooth",
              "share"
            ],
            "clipboard": {
              "read": true,
              "write": true
            }
          }
        ]
      }
    }
  }
}
