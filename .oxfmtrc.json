{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "preserve",
  "trailingComma": "all",
  "endOfLine": "lf",
  "embeddedLanguageFormatting": "off",
  "sortImports": false,
  "sortPackageJson": false
}
