*.temp
*.bak
*.orig
*.rej
*.pid

# Nelyx SDK, Metro and native generated output
/Nelyx/dist/
/Nelyx/.cache/
/Nelyx/sdk/.cache/
/Nelyx/skia/packages/*/.cache/
/Nelyx/skia/packages/rn/cpp/skia/
/Nelyx/skia/packages/rn/cpp/dawn/
/Nelyx/skia/packages/rn/generated/
/Nelyx/skia/packages/native/cpp/
/Nelyx/skia/packages/native/generated/
