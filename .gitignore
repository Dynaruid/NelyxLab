# Nelyx workspace ignore rules
# Generated Metro asset modules live in the consuming app.
**/.nelyx-metro/
**/.nelyx/
**/.cache/

# Local upstream/reference source snapshots
# Keep Nelyx-owned source and future tools/* projects tracked.
/reference/react-native-skia-main
/reference/flutter-master


# .NET build output
# Legacy local web font cache; production fonts/decoder load from CDN.
/Doroti/src/Doroti.Host.Web/wwwroot/fonts/
# Project-local temporary workspaces and reusable build caches.
**/.doroti/
**/[Bb]in/[Dd]ebug/
**/[Bb]in/[Rr]elease/
**/[Bb]in/[Ww]eb/
**/[Bb]in/[Aa]ndroid/
**/[Bb]in/[Aa]ndroid-x64/
**/[Bb]in/
# Dart migration entry points are source files, not build output.
!/tools/Nelyx.FrameworkToTypeScript/dart/bin/
!/tools/Nelyx.FrameworkToTypeScript/dart/bin/*.dart
**/[Oo]bj/
**/[Tt]est[Rr]esults/
**/[Bb]enchmark[Dd]ot[Nn]et.[Aa]rtifacts/
**/[Aa]rtifacts/
/Regolith/migration/generated/
/Regolith/migration/promotions/

# Local converter/migration scratch and regenerable IR dumps.
/.tmp/
**/.dart_tool/
/temp/
/migration/generated/.cache/
**/migration-ir.json

*.nupkg
*.snupkg

# NuGet package lock files are generated per restore target and build mode.
*.lock.json
!/Nelyx/skia/vendor/*.lock.json
!/Nelyx/skia/eng/source-build/libwebp.lock.json
!/Nelyx/skia/eng/source-build/canvaskit.lock.json

# Coverage and test-run output
**/[Cc]overage/
**/coverage.xml
**/coverage.cobertura.xml
**/*.trx
**/*.coverage
**/*.coveragexml

# Python bytecode is generated state, never validation source.
**/__pycache__/
*.py[cod]

# Visual Studio and MSBuild user state
**/.vs/
**/.mono/
*.suo
*.user
*.userosscache
*.sln.docstates
*.csproj.user
*.fsproj.user
*.vbproj.user
*.vcxproj.user
*.publishproj.user

# JetBrains Rider / ReSharper
**/.idea/
*.sln.iml
_ReSharper*/
*.DotSettings.user

# Eclipse / Buildship local metadata
**/.project

# Local editor state
/.vscode/*
!/.vscode/tasks.json
*.code-workspace
*.swp
*.swo
*~

