{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nelyx App",
  "version": "0.1.0",
  "identifier": "dev.nelyx.app.tauri",
  "build": {
    "devUrl": "http://127.0.0.1:1420/",
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nelyx App · Tauri",
        "useHttpsScheme": true,
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' blob: 'wasm-unsafe-eval'",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' blob: 'wasm-unsafe-eval' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/app.ico"
    ]
  }
}
