{
  "name": "__APP_PACKAGE__",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "doctor:web": "nelyx doctor --app . --target web",
    "prepare:web": "nelyx prepare --app . --target web",
    "dev:web": "nelyx dev --app . --target web",
    "build:web": "nelyx build --app . --target web",
    "run:web": "nelyx run --app . --target web",
    "doctor:tauri": "nelyx doctor --app . --target tauri",
    "prepare:tauri": "nelyx prepare --app . --target tauri",
    "dev:tauri": "nelyx dev --app . --target tauri",
    "build:tauri": "nelyx build --app . --target tauri",
    "pack:tauri": "nelyx pack --app . --target tauri",
    "run:tauri": "nelyx run --app . --target tauri",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nelyx/core": "0.17.0",
    "@nelyx/sdk": "0.21.0",
    "@nelyx/skia-web": "0.6.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@nelyx/material": "0.2.0",
    "@nelyx/cupertino": "0.2.0",
    "@nelyx/backend-rust": "0.1.0",
    "@nelyx/backend-wasm": "0.1.0",
    "@nelyx/backend-tauri": "0.1.0"
  },
  "devDependencies": {
    "@nelyx/vite": "0.1.0",
    "@nelyx/cli": "0.11.0",
    "@nelyx/tooling-contracts": "0.1.0",
    "vite": "8.3.8",
    "typescript": "7.0.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@tauri-apps/cli": "2.12.6"
  },
  "type": "module",
  "nelyx": {
    "schema": "nelyx.app/v4",
    "name": "NelyxTestbed",
    "appEntry": "./src/index.ts",
    "assets": [
      {
        "id": "sample-font",
        "kind": "font",
        "path": "./assets/NotoSansKR.ttf",
        "notice": {
          "path": "./assets/NotoSansKR-OFL.txt"
        },
        "fontFamily": "NelyxSample"
      },
      {
        "id": "sample-emoji",
        "kind": "font",
        "path": "./assets/NotoColorEmoji.ttf",
        "notice": {
          "path": "./assets/NotoColorEmoji.ttf.LICENSE.txt"
        },
        "fontFamily": "NelyxEmoji"
      },
      {
        "id": "sample-arabic",
        "kind": "font",
        "path": "./assets/NotoNaskhArabic-Regular.ttf",
        "notice": {
          "path": "./assets/NotoNaskhArabic-Regular.ttf.LICENSE.txt"
        },
        "fontFamily": "NelyxArabic"
      },
      {
        "id": "sample-variable",
        "kind": "font",
        "path": "./assets/RobotoSlab-VariableFont_wght.ttf",
        "notice": {
          "path": "./assets/RobotoSlab-VariableFont_wght.ttf.LICENSE.txt"
        },
        "fontFamily": "NelyxSlab"
      },
      {
        "id": "sample-hebrew",
        "kind": "font",
        "path": "./assets/NotoSansHebrew.ttf",
        "notice": {
          "path": "./assets/NotoSansHebrew-OFL.txt"
        },
        "fontFamily": "NelyxHebrew"
      },
      {
        "id": "sample-image",
        "kind": "image",
        "path": "./assets/probe.png"
      },
      {
        "id": "sample-animation",
        "kind": "image",
        "path": "./assets/pulse.gif"
      }
    ],
    "displayName": "Nelyx Testbed",
    "backend": {
      "manifest": "./backend/Cargo.toml"
    },
    "targets": {
      "web": {
        "pwa": {
          "id": "/apps/__app__",
          "shortName": "Nelyx App",
          "themeColor": "#101827",
          "icons": [
            {
              "src": "./assets/pwa/icon-192.png",
              "sizes": "192x192",
              "type": "image/png"
            },
            {
              "src": "./assets/pwa/icon-512.png",
              "sizes": "512x512",
              "type": "image/png"
            }
          ]
        }
      },
      "tauri": {
        "identifier": "dev.nelyx.app.tauri",
        "windows": [
          {
            "label": "main",
            "safeArea": true,
            "clipboard": {
              "read": true,
              "write": true
            }
          }
        ]
      }
    }
  }
}
