{
  "name": "__APP_PACKAGE__",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node web/runner/node_modules/@nelyx/cli/src/main.mjs dev --app .",
    "build:pwa": "node web/runner/node_modules/@nelyx/cli/src/main.mjs build --app .",
    "run:pwa": "node web/runner/node_modules/@nelyx/cli/src/main.mjs run --app .",
    "dev:web": "npm run dev --",
    "build:web": "npm run build:pwa --",
    "prepare:web": "node web/runner/node_modules/@nelyx/cli/src/main.mjs prepare --app .",
    "prepare:windows": "node web/runner/node_modules/@nelyx/cli/src/main.mjs prepare --app . --platform windows",
    "dev:windows": "node web/runner/node_modules/@nelyx/cli/src/main.mjs dev --app . --platform windows",
    "pack:windows": "node web/runner/node_modules/@nelyx/cli/src/main.mjs pack --app . --platform windows",
    "run:windows": "node web/runner/node_modules/@nelyx/cli/src/main.mjs run --app . --platform windows",
    "prepare:android": "node web/runner/node_modules/@nelyx/cli/src/main.mjs prepare --app . --platform android",
    "dev:android": "node web/runner/node_modules/@nelyx/cli/src/main.mjs dev --app . --platform android",
    "pack:android": "node web/runner/node_modules/@nelyx/cli/src/main.mjs pack --app . --platform android",
    "run:android": "node web/runner/node_modules/@nelyx/cli/src/main.mjs run --app . --platform android",
    "prepare:linux": "node web/runner/node_modules/@nelyx/cli/src/main.mjs prepare --app . --platform linux",
    "dev:linux": "node web/runner/node_modules/@nelyx/cli/src/main.mjs dev --app . --platform linux",
    "pack:linux": "node web/runner/node_modules/@nelyx/cli/src/main.mjs pack --app . --platform linux",
    "run:linux": "node web/runner/node_modules/@nelyx/cli/src/main.mjs run --app . --platform linux",
    "prepare:macos": "node web/runner/node_modules/@nelyx/cli/src/main.mjs prepare --app . --platform macos",
    "dev:macos": "node web/runner/node_modules/@nelyx/cli/src/main.mjs dev --app . --platform macos",
    "pack:macos": "node web/runner/node_modules/@nelyx/cli/src/main.mjs pack --app . --platform macos",
    "run:macos": "node web/runner/node_modules/@nelyx/cli/src/main.mjs run --app . --platform macos",
    "prepare:ios": "node web/runner/node_modules/@nelyx/cli/src/main.mjs prepare --app . --platform ios",
    "dev:ios": "node web/runner/node_modules/@nelyx/cli/src/main.mjs dev --app . --platform ios",
    "pack:ios": "node web/runner/node_modules/@nelyx/cli/src/main.mjs pack --app . --platform ios",
    "run:ios": "node web/runner/node_modules/@nelyx/cli/src/main.mjs run --app . --platform ios"
  },
  "dependencies": {},
  "devDependencies": {},
  "type": "module",
  "nelyx": {
    "schema": "nelyx.app/v3",
    "name": "NelyxTestbed",
    "appEntry": "./src/index.ts",
    "assets": [
      {
        "id": "sample-font",
        "kind": "font",
        "path": "./assets/NotoSansKR.ttf",
        "notice": {
          "path": "./assets/NotoSansKR-OFL.txt"
        },
        "fontFamily": "NelyxSample"
      },
      {
        "id": "sample-emoji",
        "kind": "font",
        "path": "./assets/NotoColorEmoji.ttf",
        "notice": {
          "path": "./assets/NotoColorEmoji.ttf.LICENSE.txt"
        },
        "fontFamily": "NelyxEmoji"
      },
      {
        "id": "sample-arabic",
        "kind": "font",
        "path": "./assets/NotoNaskhArabic-Regular.ttf",
        "notice": {
          "path": "./assets/NotoNaskhArabic-Regular.ttf.LICENSE.txt"
        },
        "fontFamily": "NelyxArabic"
      },
      {
        "id": "sample-variable",
        "kind": "font",
        "path": "./assets/RobotoSlab-VariableFont_wght.ttf",
        "notice": {
          "path": "./assets/RobotoSlab-VariableFont_wght.ttf.LICENSE.txt"
        },
        "fontFamily": "NelyxSlab"
      },
      {
        "id": "sample-hebrew",
        "kind": "font",
        "path": "./assets/NotoSansHebrew.ttf",
        "notice": {
          "path": "./assets/NotoSansHebrew-OFL.txt"
        },
        "fontFamily": "NelyxHebrew"
      },
      {
        "id": "sample-image",
        "kind": "image",
        "path": "./assets/probe.png"
      },
      {
        "id": "sample-animation",
        "kind": "image",
        "path": "./assets/pulse.gif"
      }
    ],
    "displayName": "Nelyx Testbed",
    "pwa": {
      "component": "./web/runner/App.tsx",
      "id": "/apps/__app__",
      "shortName": "Nelyx App",
      "themeColor": "#101827",
      "icons": [
        {
          "src": "./assets/pwa/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        },
        {
          "src": "./assets/pwa/icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ]
    }
  }
}
