{
  "name": "@nelyx/cli",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "license": "BSD-3-Clause",
  "bin": {
    "nelyx": "src/main.mjs"
  },
  "exports": {
    "./runner-configuration": {
      "types": "./src/runner-configuration.d.mts",
      "default": "./src/runner-configuration.mjs"
    },
    "./web-runner": {
      "types": "./src/web-runner.d.mts",
      "default": "./src/web-runner.mjs"
    },
    "./create-app": {
      "types": "./src/create-app.d.mts",
      "default": "./src/create-app.mjs"
    },
    "./supply-runner": {
      "types": "./src/supply-runner.d.mts",
      "default": "./src/supply-runner.mjs"
    }
  },
  "files": [
    "src",
    "README.md",
    "README.ko.md",
    "LICENSE.md",
    "templates"
  ],
  "dependencies": {
    "@nelyx/core": "0.17.0",
    "@nelyx/sdk": "0.21.0",
    "@nelyx/tooling-contracts": "0.1.0",
    "@nelyx/vite": "0.1.0"
  },
  "engines": {
    "node": ">=24.3.0 <25"
  }
}
