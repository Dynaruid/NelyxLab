if(NOT ANDROID)
  message(FATAL_ERROR "The Android host requires the pinned NDK toolchain")
endif()
foreach(required NELYX_ANDROID_SKIA_LIBS NELYX_SKIA_HEADERS NELYX_DAWN_HEADERS NELYX_ANDROID_HERMES NELYX_JSI_ROOT)
  if(NOT IS_DIRECTORY "${${required}}")
    message(FATAL_ERROR "Missing Android supplier: ${required}")
  endif()
endforeach()
set_target_properties(nelyx_engine_v2 PROPERTIES POSITION_INDEPENDENT_CODE ON)
add_library(nelyx_android_jsi SHARED "${NELYX_JSI_ROOT}/jsi/jsi.cpp")
set_target_properties(nelyx_android_jsi PROPERTIES OUTPUT_NAME jsi)
target_compile_features(nelyx_android_jsi PRIVATE cxx_std_20)
target_include_directories(nelyx_android_jsi PUBLIC "${NELYX_JSI_ROOT}")
target_link_options(nelyx_android_jsi PRIVATE -Wl,-z,max-page-size=16384)
add_library(nelyx_engine_android SHARED platform/android/host.cpp platform/android/font_services.cpp
  render/skia/paragraph_queries.cpp)
target_compile_features(nelyx_engine_android PRIVATE cxx_std_20)
target_compile_options(nelyx_engine_android PRIVATE -fexceptions -frtti -fno-fast-math)
target_compile_definitions(nelyx_engine_android PRIVATE SK_GRAPHITE SK_DAWN SK_BUILD_FOR_ANDROID JSI_USE_HERMES
  NELYX_ANDROID_SOURCE_SHA="${NELYX_ANDROID_SOURCE_SHA}")
target_include_directories(nelyx_engine_android PRIVATE "${NELYX_SKIA_HEADERS}" "${NELYX_DAWN_HEADERS}"
  "${NELYX_ANDROID_HERMES}/prefab/modules/hermesvm/include" "${NELYX_JSI_ROOT}" render/skia)
add_library(nelyx_android_hermes SHARED IMPORTED)
set_target_properties(nelyx_android_hermes PROPERTIES IMPORTED_LOCATION "${NELYX_ANDROID_HERMES}/jni/${ANDROID_ABI}/libhermesvm.so")
add_library(nelyx_android_dawn SHARED IMPORTED)
set_target_properties(nelyx_android_dawn PROPERTIES IMPORTED_LOCATION "${NELYX_ANDROID_SKIA_LIBS}/${ANDROID_ABI}/libwebgpu_dawn.so")
target_link_directories(nelyx_engine_android PRIVATE "${NELYX_ANDROID_SKIA_LIBS}/${ANDROID_ABI}")
target_link_libraries(nelyx_engine_android PRIVATE nelyx_engine_v2 nelyx_android_jsi nelyx_android_hermes nelyx_android_dawn
  -Wl,--start-group skparagraph skshaper skunicode_icu skunicode_core skia -Wl,--end-group android log jnigraphics dl z)
target_link_options(nelyx_engine_android PRIVATE -Wl,-z,max-page-size=16384 -Wl,--no-undefined)
