{
  "name": "@nelyx/skia-rn",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Reference-derived Skia RN bindings and Nelyx rendering adapters",
  "license": "BSD-3-Clause AND MIT",
  "dependencies": {
    "@nelyx/core": "0.16.0",
    "@nelyx/skia-native": "0.1.0"
  },
  "peerDependencies": {
    "react": "19.1.4 || 19.2.0",
    "react-native": "0.81.6 || 0.83.1 || 0.83.10",
    "react-native-worklets": ">=0.7.0",
    "react-native-skia-graphite-android": "154.1.0",
    "canvaskit-wasm": "0.41.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    },
    "react-native-skia-graphite-android": {
      "optional": true
    },
    "canvaskit-wasm": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src",
    "android/src",
    "android/cpp",
    "android/CMakeLists.txt",
    "android/build.gradle",
    "android/gradle.properties",
    "apple",
    "include",
    "generated",
    "native/vulkan",
    "native/linux",
    "native/windows",
    "react-native.config.cjs",
    "react-native-skia.podspec",
    "Package.swift",
    "LICENSE.md",
    "README.md",
    "native-manifest.json",
    "licenses",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    "./runtime/native-bootstrap": {
      "types": "./dist/runtime/native-bootstrap.d.ts",
      "react-native": "./src/runtime/native-bootstrap.ts",
      "default": "./dist/runtime/native-bootstrap.js"
    },
    "./skia/types/Recorder": {
      "types": "./dist/skia/types/Recorder.d.ts",
      "react-native": "./src/skia/types/Recorder.ts",
      "default": "./dist/skia/types/Recorder.js"
    },
    "./skia/types/Skia": {
      "types": "./dist/skia/types/Skia.d.ts",
      "react-native": "./src/skia/types/Skia.ts",
      "default": "./dist/skia/types/Skia.js"
    },
    "./package.json": "./package.json",
    "./native-manifest.json": "./native-manifest.json",
    "./views/graphite-types": {
      "types": "./dist/views/graphite-types.d.ts",
      "react-native": "./src/views/graphite-types.ts",
      "default": "./dist/views/graphite-types.js"
    },
    "./views/types": {
      "types": "./dist/views/types.d.ts",
      "react-native": "./src/views/types.ts",
      "default": "./dist/views/types.js"
    },
    "./apple/native-supply.json": "./apple/native-supply.json",
    "./native/vulkan/CMakeLists.txt": "./native/vulkan/CMakeLists.txt",
    "./native/vulkan/platform-context": "./generated/native-vulkan/RNSkVulkanPlatformContext.h",
    "./native/vulkan/runtime": "./generated/native-vulkan/RNSkVulkanRuntime.h",
    "./native/linux/CMakeLists.txt": "./native/linux/CMakeLists.txt",
    "./native/linux/runtime-services": "./native/linux/RuntimeServices.h",
    "./native/linux/dmabuf-texture": "./native/linux/DmaBufTexture.h",
    "./native/linux/window-surface": "./native/linux/RNSkLinuxWindowSurface.h",
    "./native/linux/component-registration": "./native/linux/SkiaViewComponent.h",
    "./native/linux/host": "./native/linux/RNSkLinuxHost.h",
    "./native/windows/runtime-services": "./native/windows/RuntimeServices.h",
    "./native/windows/host": "./native/windows/RNSkWindowsHost.h",
    "./native/windows/module": "./native/windows/RNSkiaModule.h",
    "./native/windows/composition-device": "./native/windows/CompositionDevice.h",
    "./native/windows/composition-surface": "./native/windows/CompositionSurface.h",
    "./native/windows/composition-session": "./native/windows/CompositionSession.h",
    "./native/windows/window-surface": "./native/windows/RNSkWindowsWindowSurface.h",
    "./native/windows/skia-view": "./native/windows/SkiaView.h",
    "./native/linux/view": {
      "types": "./dist/specs/SkiaViewNativeComponent.linux.d.ts",
      "react-native": "./src/specs/SkiaViewNativeComponent.linux.ts",
      "default": "./dist/specs/SkiaViewNativeComponent.linux.js"
    }
  },
  "codegenConfig": {
    "name": "rnskia",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.reactnative.skia"
    },
    "ios": {
      "componentProvider": {
        "SkiaView": "SkiaView"
      }
    }
  },
  "scripts": {
    "build": "node ../../../eng/build-packages.mjs skia-rn",
    "check": "tsc -p tsconfig.build.json --noEmit"
  }
}
