{
  "name": "nelyx-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "Nelyx",
    "Nelyx/sdk",
    "Nelyx/sdk/tooling/vite",
    "Nelyx/sdk/tooling/cli",
    "Nelyx/skia/packages/web",
    "packages/material",
    "packages/cupertino",
    "Nelyx/sdk/tooling/contracts",
    "Nelyx/backend/packages/rust",
    "Nelyx/backend/packages/wasm",
    "Nelyx/backend/packages/tauri"
  ],
  "scripts": {
    "build:sdk": "npm run build:core && npm run build:designs && npm run build:skia && npm run build --workspace @nelyx/sdk && node Nelyx/eng/generate-providers.mjs && npm run build:backend",
    "build:backend": "node Nelyx/backend/eng/build-supply.mjs",
    "generate:backend-bindings": "npm run build --workspace @nelyx/tooling-contracts && node Nelyx/backend/eng/specta-bindings.mjs --write && node Nelyx/backend/eng/build-supply.mjs --write-wasm-bindings",
    "check:backend-bindings": "node Nelyx/backend/eng/specta-bindings.mjs",
    "build:core": "npm run build --workspace @nelyx/core",
    "build:skia": "node Nelyx/skia/eng/prepare-web-runtime.mjs --check && npm run build --workspace @nelyx/skia-web",
    "build:web": "node Nelyx/eng/build-sample.mjs web",
    "build:tauri": "node Nelyx/eng/build-sample.mjs tauri",
    "deploy": "node helpers/deploy-helper/deploy.mjs",
    "prepare:sample": "node Nelyx/eng/prepare-sample.mjs",
    "pack:sdk": "node Nelyx/eng/prepare-sample.mjs --packages",
    "build:designs": "npm run build --workspace @nelyx/cupertino && npm run build --workspace @nelyx/material && npm run build --workspace @nelyx/tooling-contracts",
    "cleanup": "node cleanup-plan-all.mjs",
    "format": "oxfmt --write \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\" .oxlintrc.json .oxfmtrc.json"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "playwright": "1.64.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
