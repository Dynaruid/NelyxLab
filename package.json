{
  "name": "nelyx-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "Nelyx",
    "Nelyx/sdk",
    "Nelyx/sdk/tooling/metro",
    "Nelyx/skia/packages/native",
    "Nelyx/skia/packages/rn",
    "sample/nelyx-testbed-app-2",
    "sample/nelyx-demo-app",
    "Nelyx/sdk/tooling/cli",
    "Nelyx/skia/packages/web",
    "packages/material",
    "packages/cupertino",
    "Nelyx/sdk/tooling/contracts",
    "Nelyx/sdk/tooling/static-aot"
  ],
  "scripts": {
    "build:engine-v2": "node Nelyx/engine/tools/build.mjs",
    "build:engine-v2:android": "node Nelyx/engine/tools/build-android.mjs",
    "run:engine-v2:android": "node Nelyx/engine/tools/run-android.mjs",
    "dev:engine-v2:android": "node Nelyx/engine/tools/run-android.mjs --dev",
    "run:engine-v2:web": "node Nelyx/engine/tools/serve.mjs",
    "run:engine-v2:windows": "node Nelyx/engine/tools/run-windows.mjs",
    "run:engine-v2:windows-app-sdk": "node Nelyx/engine/tools/run-windows.mjs --host=windows-app-sdk",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "build:sdk": "npm run build:core && npm run build:designs && npm run build:skia && npm run build --workspace @nelyx/sdk && node Nelyx/eng/generate-providers.mjs && node Nelyx/eng/prepare-cli.mjs",
    "check:types": "npm run check --workspace @nelyx/core && npm run check --workspace @nelyx/tooling-contracts && npm run check --workspace @nelyx/static-aot && npm run check --workspace @nelyx/cupertino && npm run check --workspace @nelyx/material && npm run check --workspace @nelyx/skia-native && npm run check --workspace @nelyx/skia-rn && npm run check --workspace @nelyx/skia-web && npm run check --workspace @nelyx/sdk && npm run check --workspace @nelyx/testbed-2 && npm run check --workspace @nelyx/demo",
    "check:metro-types": "tsc --strict --noEmit --module NodeNext --target ES2022 --types node Nelyx/sdk/tooling/metro/src/rn-config.d.cts Nelyx/sdk/tooling/metro/src/runner-config.d.cts Nelyx/sdk/tooling/metro/src/assets.d.cts Nelyx/sdk/tooling/metro/src/web-config.d.cts Nelyx/sdk/tooling/metro/src/web-build.d.mts Nelyx/sdk/tooling/metro/src/web-development.d.mts Nelyx/sdk/tooling/metro/src/web-refresh.d.cts Nelyx/sdk/tooling/metro/src/runtime-inventory.d.mts Nelyx/sdk/tooling/metro/src/typescript-compiler.d.cts",
    "build:android": "npm run build:android --workspace @nelyx/testbed-2",
    "build:core": "npm run build --workspace @nelyx/core",
    "build:skia": "node Nelyx/skia/eng/prepare-native.mjs && npm run build --workspace @nelyx/skia-native && npm run build --workspace @nelyx/skia-rn && npm run build --workspace @nelyx/skia-web",
    "check:cli-types": "tsc --strict --noEmit --module NodeNext --target ES2022 --types node Nelyx/sdk/tooling/cli/src/windows-runner.d.mts Nelyx/sdk/tooling/cli/src/windows-v8.d.mts Nelyx/sdk/tooling/cli/src/windows-static-hermes.d.mts Nelyx/sdk/tooling/cli/src/windows-typed-hermes-policy.d.mts Nelyx/sdk/tooling/cli/src/windows-static-aot.d.mts Nelyx/sdk/tooling/cli/src/native-inputs.d.mts Nelyx/sdk/tooling/cli/src/apple-runtime.d.mts Nelyx/sdk/tooling/cli/src/linux-runner.d.mts Nelyx/sdk/tooling/cli/src/linux-inputs.d.mts Nelyx/sdk/tooling/cli/src/runner-configuration.d.mts Nelyx/sdk/tooling/cli/src/android-runner.d.mts Nelyx/sdk/tooling/cli/src/apple-runner.d.mts Nelyx/sdk/tooling/cli/src/web-runner.d.mts Nelyx/sdk/tooling/cli/src/native-development.d.mts Nelyx/sdk/tooling/cli/src/create-app.d.mts Nelyx/sdk/tooling/cli/src/supply-runner.d.mts Nelyx/sdk/tooling/cli/src/windows-aot-mode.d.mts Nelyx/sdk/tooling/cli/src/windows-jsc.d.mts Nelyx/sdk/tooling/cli/src/windows-native-runner.d.mts",
    "build:web": "npm run build:web --workspace @nelyx/testbed-2",
    "prepare:sample": "node Nelyx/eng/prepare-sample.mjs",
    "build:designs": "npm run build --workspace @nelyx/cupertino && npm run build --workspace @nelyx/material && npm run build --workspace @nelyx/tooling-contracts",
    "format": "oxfmt --write \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\" .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\" .oxlintrc.json .oxfmtrc.json"
  },
  "devDependencies": {
    "@react-native/metro-babel-transformer": "0.83.10",
    "@react-native/metro-config": "0.83.10",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.25.12",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-web": "0.21.3",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
